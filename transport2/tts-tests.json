[
  {
    "id": "transport2-1",
    "text": "今天你学得真棒！下次见！",
    "audio": "audio/621eebcca9e2.mp3"
  },
  {
    "id": "transport2-2",
    "text": "今天的中文练习完成啦！",
    "audio": "audio/e11712ab10ec.mp3"
  },
  {
    "id": "transport2-3",
    "text": "你发现哪里奇怪了吗？",
    "audio": "audio/1b01ad437164.mp3"
  },
  {
    "id": "transport2-4",
    "text": "你好！欢迎来到交通工具中文小课堂！",
    "audio": "audio/37c623a095ad.mp3"
  },
  {
    "id": "transport2-5",
    "text": "你最喜欢哪辆车？",
    "audio": "audio/0e805b573f5e.mp3"
  },
  {
    "id": "transport2-6",
    "text": "再找一找哪里不对？",
    "audio": "audio/f2f8a483eeaa.mp3"
  },
  {
    "id": "transport2-7",
    "text": "再试一次吧！",
    "audio": "audio/2a7b3e29e791.mp3"
  },
  {
    "id": "transport2-8",
    "text": "卡车",
    "audio": "audio/b728f6204f90.mp3"
  },
  {
    "id": "transport2-9",
    "text": "卡车运家具。",
    "audio": "audio/1846374f39e7.mp3"
  },
  {
    "id": "transport2-10",
    "text": "哪里怪怪的？",
    "audio": "audio/b39bccc20740.mp3"
  },
  {
    "id": "transport2-11",
    "text": "垃圾桶满了。",
    "audio": "audio/c1b8120ad51a.mp3"
  },
  {
    "id": "transport2-12",
    "text": "垃圾桶满了，谁来帮忙？",
    "audio": "audio/57d2c3755a16.mp3"
  },
  {
    "id": "transport2-13",
    "text": "垃圾车",
    "audio": "audio/35ffaa551e3d.mp3"
  },
  {
    "id": "transport2-14",
    "text": "垃圾车哪里奇怪？",
    "audio": "audio/15e1a456f130.mp3"
  },
  {
    "id": "transport2-15",
    "text": "垃圾车收垃圾。",
    "audio": "audio/b6db03313ee2.mp3"
  },
  {
    "id": "transport2-16",
    "text": "大船和小船",
    "audio": "audio/df18eca54702.mp3"
  },
  {
    "id": "transport2-17",
    "text": "小朋友迷路了。",
    "audio": "audio/3d6b5351bd32.mp3"
  },
  {
    "id": "transport2-18",
    "text": "小朋友迷路了，谁来帮忙？",
    "audio": "audio/cb31ac4b8f6c.mp3"
  },
  {
    "id": "transport2-19",
    "text": "我会说中文！",
    "audio": "audio/975f087f4ab2.mp3"
  },
  {
    "id": "transport2-20",
    "text": "我划小船。",
    "audio": "audio/10332cfa3c7b.mp3"
  },
  {
    "id": "transport2-21",
    "text": "我喜欢卡车。",
    "audio": "audio/a759bf0349ed.mp3"
  },
  {
    "id": "transport2-22",
    "text": "我喜欢垃圾车。",
    "audio": "audio/5c4e1c96354f.mp3"
  },
  {
    "id": "transport2-23",
    "text": "我喜欢救护车。",
    "audio": "audio/3eed9d20e256.mp3"
  },
  {
    "id": "transport2-24",
    "text": "我喜欢消防车。",
    "audio": "audio/ee6b262a7f10.mp3"
  },
  {
    "id": "transport2-25",
    "text": "我喜欢船。",
    "audio": "audio/96a851f90335.mp3"
  },
  {
    "id": "transport2-26",
    "text": "我喜欢警车。",
    "audio": "audio/256c842e5661.mp3"
  },
  {
    "id": "transport2-27",
    "text": "我坐公交车。",
    "audio": "audio/afd688cd3bd0.mp3"
  },
  {
    "id": "transport2-28",
    "text": "我坐大船。",
    "audio": "audio/b97cdec13164.mp3"
  },
  {
    "id": "transport2-29",
    "text": "我坐小汽车。",
    "audio": "audio/68790e7821d5.mp3"
  },
  {
    "id": "transport2-30",
    "text": "我坐火车。",
    "audio": "audio/da2ac81225c4.mp3"
  },
  {
    "id": "transport2-31",
    "text": "我坐飞机。",
    "audio": "audio/e3570e77934c.mp3"
  },
  {
    "id": "transport2-32",
    "text": "我骑自行车。",
    "audio": "audio/95eafb03a65a.mp3"
  },
  {
    "id": "transport2-33",
    "text": "房子着火了。",
    "audio": "audio/7a45a249a064.mp3"
  },
  {
    "id": "transport2-34",
    "text": "房子着火了，谁来帮忙？",
    "audio": "audio/f352399cb59b.mp3"
  },
  {
    "id": "transport2-35",
    "text": "救护车",
    "audio": "audio/c8a530c65b81.mp3"
  },
  {
    "id": "transport2-36",
    "text": "救护车来帮忙！",
    "audio": "audio/0b759f5ad7d0.mp3"
  },
  {
    "id": "transport2-37",
    "text": "消防车",
    "audio": "audio/123dd27e893c.mp3"
  },
  {
    "id": "transport2-38",
    "text": "消防车哪里奇怪？",
    "audio": "audio/4d175e16b8fb.mp3"
  },
  {
    "id": "transport2-39",
    "text": "消防车来帮忙！",
    "audio": "audio/7f4a04ebeba4.mp3"
  },
  {
    "id": "transport2-40",
    "text": "点图片，听一听，再说一说。",
    "audio": "audio/2ee813240cf3.mp3"
  },
  {
    "id": "transport2-41",
    "text": "答对啦！你真棒！",
    "audio": "audio/8940fc7f6513.mp3"
  },
  {
    "id": "transport2-42",
    "text": "老爷爷摔倒了。",
    "audio": "audio/674ce937fb6f.mp3"
  },
  {
    "id": "transport2-43",
    "text": "老爷爷摔倒了，谁来帮忙？",
    "audio": "audio/649ba9770fc2.mp3"
  },
  {
    "id": "transport2-44",
    "text": "船",
    "audio": "audio/7def9ee0ca92.mp3"
  },
  {
    "id": "transport2-45",
    "text": "要搬家具，用什么车？",
    "audio": "audio/7acb8f16260e.mp3"
  },
  {
    "id": "transport2-46",
    "text": "警车",
    "audio": "audio/83c8b9fa8c9f.mp3"
  },
  {
    "id": "transport2-47",
    "text": "警车来帮忙！",
    "audio": "audio/5fbfc51bc79c.mp3"
  },
  {
    "id": "transport2-48",
    "text": "请听一听，找到正确的车。",
    "audio": "audio/21265be1ddb9.mp3"
  },
  {
    "id": "transport2-49",
    "text": "这是什么？",
    "audio": "audio/7035a8518c40.mp3"
  },
  {
    "id": "transport2-50",
    "text": "这是。",
    "audio": "audio/5d25eae4936c.mp3"
  },
  {
    "id": "transport2-51",
    "text": "这是卡车。",
    "audio": "audio/12aee884679b.mp3"
  },
  {
    "id": "transport2-52",
    "text": "这是垃圾车。",
    "audio": "audio/6d989ccee966.mp3"
  },
  {
    "id": "transport2-53",
    "text": "这是大船，这是小船。我划小船。",
    "audio": "audio/669605108a59.mp3"
  },
  {
    "id": "transport2-54",
    "text": "这是救护车。",
    "audio": "audio/516dcc11223d.mp3"
  },
  {
    "id": "transport2-55",
    "text": "这是消防车。",
    "audio": "audio/2f7f9e2d08a0.mp3"
  },
  {
    "id": "transport2-56",
    "text": "这是船。",
    "audio": "audio/1e7cb653eda8.mp3"
  },
  {
    "id": "transport2-57",
    "text": "这是警车。",
    "audio": "audio/30f19dc566d8.mp3"
  }
]
